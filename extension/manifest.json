{
  "manifest_version": 3,
  "name": "Syllabus Lens for Keio | 授業レビューをシラバスでひと目で確認",
  "version": "0.2.0",
  "description": "慶應義塾大学のシラバス画面に、K-Support の授業評価結果を見やすく表示します。",
  "permissions": ["storage", "tabs", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://gslbs.keio.jp/*",
    "https://keiouniversity.my.site.com/*",
    "https://www.keio.ac.jp/*"
  ],
  "action": {
    "default_title": "Syllabus Lens for Keio",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://keiouniversity.my.site.com/students/*"],
      "js": ["src/shared.js", "src/probe-bridge.js", "src/ksupport-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gslbs.keio.jp/pub-syllabus/*",
        "https://gslbs.keio.jp/syllabus/*"
      ],
      "exclude_matches": [
        "https://gslbs.keio.jp/pub-syllabus/result*",
        "https://gslbs.keio.jp/syllabus/result*"
      ],
      "js": ["src/shared.js", "src/syllabus-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gslbs.keio.jp/pub-syllabus/result*",
        "https://gslbs.keio.jp/syllabus/result*"
      ],
      "js": ["src/shared.js", "src/syllabus-result-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page-probe.js"],
      "matches": ["https://keiouniversity.my.site.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
